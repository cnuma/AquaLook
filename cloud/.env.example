# Copier en .env et renseigner. Le fichier .env n'est jamais versionne.
# Generer les mots de passe aleatoirement, par exemple :
#   openssl rand -base64 24

# Domaine public pointant vers cette machine (necessaire pour TLS Let's Encrypt)
DOMAIN=aqualook.exemple.fr
TZ=Europe/Paris

# Base de donnees
POSTGRES_DB=aqualook
POSTGRES_USER=aqualook
POSTGRES_PASSWORD=CHANGEME

# Compte MQTT de la passerelle (le seul a voir tous les modules).
# Ne doit JAMAIS se retrouver dans un firmware.
BRIDGE_MQTT_USER=aqualook-bridge
BRIDGE_MQTT_PASSWORD=CHANGEME

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEME
