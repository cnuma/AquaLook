# Copier en .env, jamais versionne (voir .gitignore).

# Jeton d'administration, pour /admin/*. Generer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=CHANGEME

# Chemin de la base SQLite. Le dossier est cree automatiquement s'il n'existe pas.
DATABASE_PATH=data/aqualook.db
