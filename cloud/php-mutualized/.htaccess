# Renvoie tout vers index.php, qui route lui-meme sur REQUEST_URI.
# Standard sur l'hebergement mutualise OVH (Apache + mod_rewrite deja actif).
RewriteEngine On
# La console (fichiers existants, donc hors de la regle generale) passe par
# index.php, qui exige l'authentification Basic (console_page.php).
RewriteRule ^admin\.(html|js)$ index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Le .env et le schema ne doivent jamais etre servis directement.
# router.php n'existe que pour le serveur de developpement integre : le laisser
# accessible offrirait un second chemin d'entree vers index.php, non couvert par
# les reecritures ci-dessus.
# cleanup.php est reserve a la tache planifiee AlwaysData (CLI) : une requete
# HTTP ne doit jamais declencher une purge (le script se protege aussi lui-meme
# via PHP_SAPI, en ceinture).
# Les .md sont de la documentation de developpement, sans interet public.
# schema*.sql couvre aussi les migrations (schema-v2..., schema-v4...), que
# l'ancien motif schema\.sql laissait servir.
# *.log : un journal d'erreurs PHP ecrit dans la racine web (php.log, error.log)
# serait servi tel quel -- la reecriture vers index.php ne s'applique pas a un
# fichier qui existe sur disque (RewriteCond !-f). Il revelerait les chemins
# absolus du serveur et des traces de pile. Non observe en production (le log
# PHP est ailleurs), mais la garde coute une ligne et ferme le cas latent.
# Fichiers PHP internes (inclus par index.php, jamais appeles directement) :
# appeles seuls ils ne rendent rien, mais n'ont aucune raison de repondre.
# require() lit le disque et n'est pas concerne par ce refus.
<FilesMatch "^(\.env.*|schema.*\.sql|router\.php|cleanup\.php|(account|auth|console_page|db|enroll|env|mail|settings)\.php|.*\.md|.*\.log)$">
    Require all denied
</FilesMatch>

# En-tetes de securite (defense en profondeur). Gardes par <IfModule> : sans
# mod_headers, ces lignes sont ignorees au lieu de provoquer une 500.
#
# Aucune page ne charge de ressource externe : default-src 'self' ne casse
# rien. script-src SANS 'unsafe-inline' sur tout le site : admin.html,
# app.html (P0.4b) et /editeur/ (P0.4d, script dans script-editeur.js) n'ont
# plus de script inline ; un <script> ou un attribut on*= injecte ne s'y
# execute plus. style-src garde 'unsafe-inline' (attributs style= nombreux,
# risque faible). Les copies de pages du module sous /web/ gardent du script
# inline : elles sont destinees aux modules, pas a un navigateur sur ce site.
#
# X-Robots-Tag : aucun moteur de recherche ne doit indexer le service
# (complete robots.txt ; seuls les robots polis l'appliquent, ce n'est pas
# une protection).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    # HSTS host-only (ni includeSubDomains ni preload : ce n'est qu'un
    # sous-domaine d'alwaysdata.net). Le site est servi en HTTPS ; monter
    # max-age apres verification.
    Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# Pas de listing de repertoire : /web/ ne doit pas enumerer les versions
# publiees, meme si elles ne sont pas secretes.
Options -Indexes

# Masquage des erreurs PHP : elles revelent le chemin absolu du serveur.
#
# Volontairement encadre par <IfModule> : php_flag n'est reconnu que par
# mod_php, et provoque une erreur 500 sur TOUT le site sous PHP-FPM. La garde
# rend ces lignes inoffensives la ou elles ne s'appliquent pas.
#
# Ce n'est qu'une ceinture : la vraie protection est dans index.php, qui pose
# display_errors avant son premier require et fonctionne quel que soit
# l'hebergeur.
<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors off
</IfModule>
