# Copier en .env, jamais versionne (voir .gitignore). Sur OVH mutualise, les
# identifiants MySQL sont fournis dans l'espace client (hebergements ->
# bases de donnees).

DB_HOST=127.0.0.1
# 3306 en production. Le 3307 du README ne concerne QUE la MariaDB
# portable du poste de developpement.
DB_PORT=3306
DB_NAME=aqualook
DB_USER=CHANGEME
DB_PASSWORD=CHANGEME

# Genere avec : php -r "echo bin2hex(random_bytes(32));"
ADMIN_TOKEN=CHANGEME

# Mails (D016) : FACULTATIF. Ces parametres se reglent normalement depuis la
# console d'administration (bouton "Parametres"), qui les range en base et
# l'emporte sur ce fichier. Les renseigner ici ne sert que de repli.
# MAIL_SMTP_HOST=smtp-<compte>.alwaysdata.net
# MAIL_SMTP_PORT=465
# MAIL_SMTP_USER=<adresse de la boite>
# MAIL_SMTP_PASS=<mot de passe de la boite>
# MAIL_FROM=<adresse de la boite>
# MAIL_FROM_NAME=AquaLook
# Banc local uniquement (certificat SMTP auto-signe) ; jamais en production.
# MAIL_SMTP_CAFILE=
